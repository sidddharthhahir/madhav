# ---------------------------------------------------------------------------
# Raw upstream cache -- MUST NOT be committed.
#
# These are the unfiltered vedicscriptures payloads. They contain every
# translation the upstream API returns, including A.C. Bhaktivedanta Swami
# Prabhupada's (BBT, in copyright until 2038), Chinmayananda's, and
# Ramsukhdas's. The rights policy in src/gita/sources.py keeps all of those out
# of the database; the cache keeps them locally only so exclusions can be
# re-audited without re-crawling. Committing this directory would publish
# copyrighted translations and defeat the entire point of that policy.
#
# Regenerate with: python -m gita.ingest.run
# ---------------------------------------------------------------------------
data/cache/

# The corpus IS committed (data/gita.sqlite3, ~22 MB), so a fresh clone on any
# machine works immediately with no ingest run and no network. It is verified
# rights-clean by scripts/verify_store.py -- every row is permitted by the
# policy in src/gita/sources.py.
#
# Checkpoint the WAL before committing an updated copy, or the commit captures
# an incomplete file:
#   python -c "import sqlite3;c=sqlite3.connect('data/gita.sqlite3');c.execute('PRAGMA wal_checkpoint(TRUNCATE)')"
data/*.sqlite3-wal
data/*.sqlite3-shm

# Downloaded raw source dumps (archive.org OCR layers and similar). Large,
# re-fetchable, and not authored here. src/gita/ingest/gitapress.py documents
# where each one comes from.
data/sources/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets -- never commit these.
.env

# Personal state: the questions actually asked on this machine and the verses
# kept. The corpus (data/gita.sqlite3) IS committed and is meant to be; this
# is not. Keeping them in one file meant one `git add` would publish someone's
# questions to a public repo permanently.
data/local.sqlite3
data/local.sqlite3-wal
data/local.sqlite3-shm

# Design tool exports. The working copies live in frontend/ -- these zips are
# redundant packaging of the same two files.
*.zip

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
